# الخادم والإعدادات العامة
PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# اعتمادات الأدمن (اسم المستخدم والهاش المشفر لكلمة المرور)
# لتوليد الهاش المشفر لـ ADMIN_PASS_HASH، استخدم سكربت hash-password.js
ADMIN_USER=admin
ADMIN_PASS_HASH=your_bcrypt_hash_of_admin_password_here

# إعدادات حساب Cloudinary الخاص برفع الصور
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
